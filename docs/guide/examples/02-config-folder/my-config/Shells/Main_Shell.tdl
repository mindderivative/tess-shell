---
TDL: 0.2
Name: Main_Shell
---
# A shell file may use any module found in Modules/, next to the ones the shell ships.
Shell {
    Monitor {
        Name: Main
        Index: default
        Children {
            Bar {
                Name: Top_Bar
                Edge: TOP
                Width: EXPAND
                Height: 32
                Style { Background: $color.surface }
                Children {
                    FlexBox {
                        Width: EXPAND
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Padding: [12, 0, 12, 0]
                        Children {
                            Greeting { name: "Ada" }
                            Spacer { }
                            Clock { }
                        }
                    }
                }
            }
        }
    }
}
