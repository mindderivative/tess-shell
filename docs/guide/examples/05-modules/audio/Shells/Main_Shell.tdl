---
TDL: 0.2
Name: Main_Shell
---
# The secondary-click menu of outputs is the Popup Audio_Outputs, which the shell provides.
Shell {
    Monitor {
        Name: Main
        Index: default
        Children {
            Bar {
                Name: Top_Bar
                Edge: TOP
                Width: EXPAND
                Height: 36
                Style { Background: $color.surface }
                Children {
                    FlexBox {
                        Width: EXPAND
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Spacing: 16
                        Padding: [12, 0, 12, 0]
                        Children {
                            Spacer { }
                            Audio { show_percent: true, show_slider: false, step: 5 }
                        }
                    }
                }
            }
        }
    }
}
