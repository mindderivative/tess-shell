---
TDL: 0.2
Name: Main_Shell
---
Shell {
    Monitor {
        Name: Main
        Index: default
        Children {
            Bar {
                Name: Top_Bar
                Edge: TOP
                Width: EXPAND
                Height: 36
                Style { Background: $color.surface }
                Children {
                    FlexBox {
                        Width: EXPAND
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Spacing: 16
                        Padding: [12, 0, 12, 0]
                        Children {
                            ProgressBar { Value: 65, Label: "Download" }
                            ProgressBar { Value: 12, Min: 0, Max: 20, Width: 80, Label: "Disk quota" }
                        }
                    }
                }
            }
        }
    }
}
