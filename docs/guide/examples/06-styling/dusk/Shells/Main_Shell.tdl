---
TDL: 0.2
Name: Main_Shell
---
Shell {
    Monitor {
        Name: Main
        Index: default
        Children {
            Bar {
                Name: Top_Bar
                Edge: TOP
                Width: EXPAND
                Height: 36
                Style { Background: $color.surface }
                Children {
                    FlexBox {
                        Width: EXPAND
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Spacing: 12
                        Padding: [12, 0, 12, 0]
                        Children {
                            Text { Text: "Battery low", Class: warn }
                            FlexBox {
                                Class: chip
                                Padding: [10, 4, 10, 4]
                                Children { Text { Text: "A chip", Font_Family: $type.system.font_family } }
                            }
                            Spacer { }
                            Clock { }
                        }
                    }
                }
            }
        }
    }
}
