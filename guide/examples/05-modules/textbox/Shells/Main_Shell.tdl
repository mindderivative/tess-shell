---
TDL: 0.2
Name: Main_Shell
---
Shell {
    Monitor {
        Name: Main
        Index: default
        Children {
            Bar {
                Name: Top_Bar
                Edge: TOP
                Width: EXPAND
                Height: 36
                Style { Background: $color.surface }
                Children {
                    FlexBox {
                        Width: EXPAND
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Spacing: 16
                        Padding: [12, 0, 12, 0]
                        Children {
                            TextBox { Text: "TextBox wraps at word ends when it has a width and stops after Max_Lines lines, however long the text is.", Width: 220, Max_Lines: 2 }
                        }
                    }
                }
            }
        }
    }
}
