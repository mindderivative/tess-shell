---
TDL: 0.1
Shell: 0.1
Name: Battery
---

# The charge of the machine's battery (Battery Module): an icon, the percentage and a tooltip with the
# state and the time left. The Python sends `present`, `percent`, `state`, `icon`, `low`, `critical`,
# `tooltip` and `label`; the layer sends `available` (UPower is on the bus). With UPower absent or
# no battery the module is hidden: its root is `Visible: false`, which takes no space in the Bar
# (no Spacing beside it) and shows no placeholder.
#
# `low` and `critical` come from UPower's own warning level: the icon and the number take the
# theme's warning and error colour, and a dot of that colour appears beside them (the icon also
# changes shape with the level: the colour is never the only sign). The icon is the name the Python
# sends in `icon`, looked up in the icon sets when it changes.
Module {
    Style: Battery_Style.tdl

    Params {
        # the number next to the icon
        show_percent { Type: boolean, Default: true }
    }

    FlexBox {
        Name: Root
        Visible: {{ available and present }}
        Role: GROUP
        Label: {{ label }}
        Flex: HORIZONTAL
        Align_Items: CENTER
        Tooltip {
            Alignment: CENTER
            Gap: 4
            Style {
                Background: $color.surface_raised
                Corner_Radius: 8
                Elevation: 20%
            }
            Children {
                FlexBox {
                    Padding: [12, 8, 12, 8]
                    Children {
                        Text {
                            Text: {{ tooltip }}
                            Width: AUTO
                            Height: AUTO
                            Font_Size: 14
                            Foreground: $color.on_surface
                        }
                    }
                }
            }
        }
        Children {
            If {{ critical }} {
                FlexBox {
                    Name: Level_Critical
                    Flex: HORIZONTAL
                    Align_Items: CENTER
                    Spacing: 4
                    Children {
                        SVG {
                            Name: Glyph_Critical
                            Icon: {{ icon }}
                            Width: 16
                            Height: 16
                            A11y_Hidden: true
                            Foreground: $color.error
                        }
                        Circle { Name: Alarm_Critical, Diameter: 6, Fill: $color.error }
                        If {{ params.show_percent }} {
                            Text {
                                Name: Percent_Critical
                                Class: battery_text
                                Text: {{ percent }} %
                                Foreground: $color.error
                            }
                        }
                    }
                }
            } Else {
                If {{ low }} {
                    FlexBox {
                        Name: Level_Low
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Spacing: 4
                        Children {
                            SVG {
                                Name: Glyph_Low
                                Icon: {{ icon }}
                                Width: 16
                                Height: 16
                                A11y_Hidden: true
                                Foreground: $color.warning
                            }
                            Circle { Name: Alarm_Low, Diameter: 6, Fill: $color.warning }
                            If {{ params.show_percent }} {
                                Text {
                                    Name: Percent_Low
                                    Class: battery_text
                                    Text: {{ percent }} %
                                    Foreground: $color.warning
                                }
                            }
                        }
                    }
                } Else {
                    FlexBox {
                        Name: Level
                        Flex: HORIZONTAL
                        Align_Items: CENTER
                        Spacing: 4
                        Children {
                            SVG {
                                Name: Glyph
                                Icon: {{ icon }}
                                Width: 16
                                Height: 16
                                A11y_Hidden: true
                            }
                            If {{ params.show_percent }} {
                                Text { Name: Percent, Class: battery_text, Text: {{ percent }} % }
                            }
                        }
                    }
                }
            }
        }
    }
}
