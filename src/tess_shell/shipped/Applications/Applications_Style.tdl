---
TDL: 0.2
Shell: 0.1
Name: Applications_Style
---

Style {
    Classes {
        app_name {
            Kind: Text
            Overflow: ELLIPSIS
        }
        app_comment {
            Kind: Text
            Overflow: ELLIPSIS
            Font_Size: 12
            Foreground: $color.on_surface_muted
        }
        app_message {
            Kind: Text
            Foreground: $color.on_surface_muted
        }
    }
}
