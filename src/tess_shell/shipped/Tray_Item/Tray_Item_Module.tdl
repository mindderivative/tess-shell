---
TDL: 0.2
Shell: 0.1
Name: Tray_Item
---

# One item of the Tray (Tray Module): its icon with a tooltip (the item's title and its text). The
# Tray calls it in a `For` and writes the item's handlers on the call, so they run the Tray's
# actions. `icon` is what the Tray sends: an SVG document or `pixels:...` (an Icon shows both).
# `attention` gives the root the `:selected` look (the stylesheet's `.tray_item:selected`).
Module {
    Style: Tray_Item_Style.tdl

    Params {
        icon { Type: icon, Default: "" }
        size { Type: number, Default: 0 }
        tooltip_title { Type: string, Default: "" }
        tooltip_text { Type: string, Default: "" }
        label { Type: string, Default: "" }
        description { Type: string, Default: "" }
        # the item needs attention: it takes the `:selected` look
        attention { Type: boolean, Default: false }
    }

    FlexBox {
        Name: Root
        Class: tray_item
        Role: BUTTON
        Selected: <| params.attention |>
        Label: <| params.label |>
        Description: <| params.description |>
        Width: <| density.item_size |>
        Height: <| density.item_size |>
        Align_Items: CENTER
        Justify_Content: CENTER
        Tooltip {
            Alignment: CENTER
            Gap: 4
            Children {
                FlexBox {
                    Padding: [8, 4, 8, 4]
                    Flex: VERTICAL
                    Children {
                        Text {
                            Text: <| params.tooltip_title |>
                            Width: AUTO
                            Height: AUTO
                            Font_Size: 14
                            Font_Weight: 600
                            Foreground: $color.inverse_on_surface
                        }
                        Text {
                            Text: <| params.tooltip_text |>
                            Visible: <| params.tooltip_text != "" |>
                            Width: AUTO
                            Height: AUTO
                            Font_Size: 13
                            Foreground: $color.inverse_on_surface
                        }
                    }
                }
            }
        }
        Children {
            Icon { Icon: <| params.icon |>, Size: <| params.size if params.size > 0 else density.item_icon_size |> }
            # attention is not colour alone: a 6 dp dot in the corner (Tray Item > States)
            FlexBox {
                Name: Attention
                Visible: <| params.attention |>
                Position: ABSOLUTE
                Top: 2
                Right: 2
                Width: 6
                Height: 6
                Corner_Radius: 3
                Background: $color.warning
                A11y_Hidden: true
            }
        }
    }
}
